rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }

    // Copia de cada cuenta: solo su dueño, con el correo verificado
    match /users/{uid} {
      allow read, write: if verified() && request.auth.uid == uid;
    }
    // Alias y códigos de invitación: se comprueban con sesión; se reclaman una vez y a tu nombre
    match /aliases/{alias} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }
    match /codes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }
    // Invitaciones completadas: las crea el invitado (una por persona) y solo las lee quien invitó
    match /referrals/{inviteeUid} {
      allow create: if signedIn() && request.auth.uid == inviteeUid && request.resource.data.inviterUid != inviteeUid;
      allow read: if signedIn() && resource.data.inviterUid == request.auth.uid;
    }
    // Perfil público mínimo (alias, universidad, minutos de la semana): lo ven las cuentas verificadas; cada uno escribe el suyo
    match /profiles/{uid} {
      allow read: if verified();
      allow write: if verified() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['alias', 'aliasLower', 'uni', 'weekKey', 'weekFocus', 'liveUntil', 'photo', 'updatedAt']);
    }
    // Amistades: solo las dos personas implicadas
    match /friends/{pair} {
      allow read: if verified() && request.auth.uid in resource.data.users;
      allow create: if verified() && request.resource.data.from == request.auth.uid
        && request.auth.uid in request.resource.data.users && request.resource.data.users.size() == 2
        && request.resource.data.status == 'pending';
      allow update: if verified() && request.auth.uid in resource.data.users
        && request.resource.data.users == resource.data.users && request.resource.data.from == resource.data.from;
      allow delete: if verified() && request.auth.uid in resource.data.users;
    }
    // Grupos de ranking: cualquiera verificado puede buscar por código; cada uno solo se añade o se quita a sí mismo
    match /fgroups/{gid} {
      allow read: if verified();
      allow create: if verified() && request.resource.data.owner == request.auth.uid
        && request.auth.uid in request.resource.data.members && request.resource.data.members.size() <= 50;
      allow update: if verified() && (
        request.auth.uid == resource.data.owner
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && request.resource.data.members.size() <= 50
            && (request.resource.data.members.toSet().difference(resource.data.members.toSet()) == [request.auth.uid].toSet()
                || resource.data.members.toSet().difference(request.resource.data.members.toSet()) == [request.auth.uid].toSet())));
      allow delete: if verified() && request.auth.uid == resource.data.owner;
    }
  }
}
